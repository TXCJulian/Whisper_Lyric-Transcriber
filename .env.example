# Copy to .env and fill in.

# Required — Genius API token for lyrics correction.
# Create an API client at https://genius.com/api-clients
GENIUS_ACCESS_TOKEN=your_token_here

# Optional — Hugging Face token. Anonymous downloads are rate limited; an
# authenticated token gives faster downloads of the ~5 GB model cache on first
# start. Create one at https://huggingface.co/settings/tokens (read scope).
HF_TOKEN=

# Optional — image variant to build with docker compose: nvidia (default,
# covers every NVIDIA generation), intel, amd or cpu.
# GPU_BACKEND=nvidia

# Optional — runtime override inside the container. Leave unset to let the
# image decide (on NVIDIA it picks the modern or legacy environment by GPU
# generation). nvidia-legacy forces the legacy environment, cpu forces CPU.
# Outside Docker (uv run ...), set GPU_BACKEND to the same values instead.
# RUNTIME_GPU_BACKEND=

# Optional — batch processing (POST /batch) reads songs from mounted storage.
# Comma-separated directories it may read from; empty disables batch mode.
# TRANSCRIBER_ALLOWED_ROOTS=/music
# Where batch results go: download (default; kept for download only) or
# alongside (also written next to each song; needs a writable mount).
# TRANSCRIBER_BATCH_OUTPUT=download

# Optional — Genius correction threshold in percent. Below it the Genius
# lyrics are discarded and the Whisper transcription is kept. 0 = always correct.
# CORRECTION_MIN_MATCH=0
